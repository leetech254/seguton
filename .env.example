MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=seguton

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# CourtneyTech STK Push (add these in Vercel, never in frontend code)
COURTNEY_API_KEY=courtneytech_key_xxxx
COURTNEY_API_SECRET=courtneytech_secret_xxxx
COURTNEY_ACCOUNT_ID=1
COURTNEY_BASE_URL=https://courtneytech.xyz/api
COURTNEY_CALLBACK_BASE_URL=https://your-domain.vercel.app
COURTNEY_CALLBACK_SECRET=replace-with-another-random-secret

# Tenant and administrator notifications (set either channel or both)
RESEND_API_KEY=re_xxxx
NOTIFICATION_FROM_EMAIL=SEGUTON <notifications@your-domain.com>
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=SEGUTON
