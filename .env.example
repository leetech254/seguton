MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=seguton

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_URL=https://seguton.yemtech.store

# LeeTec M-Pesa STK Push (server-side only; never expose the API key in frontend code)
LEETEC_API_KEY=replace-with-your-leetec-api-key
LEETEC_BASE_URL=https://leetec.online
# Optional: only needed if you configure a signed LeeTec merchant webhook.
# Without this variable, the app confirms payments through LeeTec status polling.
LEETEC_WEBHOOK_SECRET=replace-with-your-leetec-webhook-secret

# Administrator verification/reset and email notifications.
# The sender domain must be verified in Resend; a personal Gmail/Yahoo sender is not valid for production.
RESEND_API_KEY=re_xxxx
NOTIFICATION_FROM_EMAIL=SEGUTON <notifications@seguton.yemtech.store>

# Optional tenant SMS notifications
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=SEGUTON
